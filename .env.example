# Anthropic API 키 (없으면 데모 모드로 동작: 미리 준비된 악몽 사용)
ANTHROPIC_API_KEY=

# 생성 모델 (기본: claude-opus-5-5)
NIGHTMAIRE_MODEL=claude-opus-5-5

# 생성 effort: low | medium | high (워크숍 현장 지연시간을 줄이려면 low)
NIGHTMAIRE_EFFORT=medium

# 1로 설정하면 API 키가 있어도 항상 데모 모드
DEMO_MODE=

# 장면 그림 (OpenAI 이미지 모델). 키가 없거나 NIGHTMAIRE_IMAGES=0이면 코드로 그리는 캔버스를 쓴다.
OPENAI_API_KEY=
# NIGHTMAIRE_IMAGE_MODEL=gpt-image-2.6-flare
# NIGHTMAIRE_IMAGE_QUALITY=medium
